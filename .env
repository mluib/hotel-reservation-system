# These values are committed on purpose for this demo/portfolio project, so that
# `docker-compose up` works immediately for anyone cloning the repo, with no setup step.
# They are dev-only placeholders, not real secrets -- the JWT key here is not used anywhere
# outside this project, and the SQL Server / admin-seed credentials only ever reach a local
# container on your own machine.
#
# This is NOT how a real project should handle this file: in normal development, .env must
# be gitignored (never committed) to avoid leaking secrets, with a .env.example committed
# instead as a template. This repo deliberately trades that off for a zero-friction demo.

MSSQL_SA_PASSWORD=HotelDev_2026!
JWT_KEY=ql8UiF/DgXWrZniua1SrrhAWE8QhNDWBZOwrAtlTGuE=
SEED_ADMIN_EMAIL=admin@hotel.local
SEED_ADMIN_PASSWORD=Admin123!
